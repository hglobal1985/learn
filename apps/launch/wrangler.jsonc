{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "learn",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "learn.hglobal1985.com", "custom_domain": true }],
  "alias": { "learn:static": "./.generated/static-files.js" },
  "d1_databases": [
    { "binding": "DB", "database_name": "learn-v2", "database_id": "f1283fdd-94f1-4a43-97b4-3072d1876ced", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "learn" }],
  // Cloudflare Email Service（網域 mail.hglobal1985.com 已開通寄信）；只用來寄通知，不需要金鑰。
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@mail.hglobal1985.com"] }],
  "vars": { "DEMO_LOGIN": "off", "EMAIL_FROM": "noreply@mail.hglobal1985.com" },
  // MUX_SIGNING_KEY_ID 由業主在 Cloudflare 後台設定；部署時保留後台的變數，避免被清掉。
  "keep_vars": true,
  "observability": { "enabled": true }
}
