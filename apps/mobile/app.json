{
  "expo": {
    "name": "寰宇行動大學",
    "slug": "learn",
    "scheme": "learn",
    "version": "0.2.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-document-picker",
      "expo-secure-store",
      "expo-web-browser",
      ["expo-video", { "supportsBackgroundPlayback": true, "supportsPictureInPicture": true }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#F6F5F0",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121515"
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "寰宇行動大學",
      "favicon": "./assets/favicon.png",
      "lang": "zh-Hant"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hglobal1985.learn",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hglobal1985.learn",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14663F"
      }
    },
    "icon": "./assets/icon.png"
  }
}